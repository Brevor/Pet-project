{
  "name": "@studioflow/server",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "main": "dist/src/server.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/**/*.test.js\"",
    "db:migrate": "tsc -p tsconfig.json && node dist/src/db/migrate.js"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.8",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.2.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
